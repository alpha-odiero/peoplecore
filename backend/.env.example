NODE_ENV=development
PC_API_PORT=3000
PC_API_HOST=0.0.0.0
PC_PUBLIC_URL=http://localhost:3000
PC_WEB_ORIGIN=http://localhost:5173,https://peoplecore-rho.vercel.app
PC_LOG_LEVEL=debug

# Local defaults below. In production, replace BOTH with the Supabase
# "Session pooler" string (port 5432) from Dashboard -> Connect -> Session pooler.
# Render is IPv4-only; the direct db.<ref>.supabase.co:5432 host is IPv6-only.
# Pattern: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres?schema=public&sslmode=require
# Percent-encode special characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peoplecore?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/peoplecore?schema=public
PC_DATABASE_SHADOW_URL=postgresql://postgres:postgres@localhost:5432/peoplecore_shadow?schema=public
PC_DATABASE_SSL=false
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

PC_REDIS_URL=
PC_REDIS_TLS=false
PC_CACHE_FALLBACK=true

PC_JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes-access
PC_JWT_REFRESH_SECRET=replace-with-at-least-32-random-bytes-refresh
PC_JWT_ACCESS_TTL=900
PC_JWT_REFRESH_TTL=1209600
PC_CSRF_SECRET=replace-with-at-least-32-random-bytes-csrf

PC_COOKIE_DOMAIN=localhost
PC_COOKIE_SECURE=false
PC_COOKIE_SAME_SITE=strict

PC_STORAGE_DRIVER=local
PC_STORAGE_LOCAL_ROOT=./var/storage
PC_STORAGE_BUCKET=peoplecore
PC_STORAGE_ENDPOINT=http://localhost:9000
PC_STORAGE_REGION=us-east-1
PC_STORAGE_ACCESS_KEY=minioadmin
PC_STORAGE_SECRET_KEY=minioadmin
PC_STORAGE_USE_SSL=false

PC_MAIL_DRIVER=log
PC_MAIL_FROM=no-reply@peoplecore.local
PC_SMTP_URL=

PC_METRICS_ENABLED=true
PC_METRICS_PORT=9090
PC_SWAGGER_ENABLED=true

PC_DEFAULT_TENANT_SLUG=demo
PC_DEFAULT_TENANT_NAME=PeopleCore Demo
PC_DEFAULT_ADMIN_EMAIL=admin@peoplecore.local
PC_DEFAULT_ADMIN_PASSWORD=ChangeMe!2345
