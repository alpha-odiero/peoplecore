{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "rootDir": "../../..",
  "testMatch": ["<rootDir>/apps/api/test/**/*.e2e-spec.ts", "<rootDir>/tests/**/*.e2e-spec.ts"],
  "moduleNameMapper": {
    "^@peoplecore/shared$": "<rootDir>/packages/shared/src/index.ts",
    "^@/(.*)$": "<rootDir>/apps/api/src/$1"
  },
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.base.json"
      }
    ]
  },
  "setupFilesAfterEnv": ["<rootDir>/apps/api/test/setup-e2e.ts"],
  "testTimeout": 30000
}
