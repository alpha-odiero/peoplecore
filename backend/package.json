{
  "name": "peoplecore-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "workspaces": [
    "apps/api",
    "packages/shared",
    "tests"
  ],
  "scripts": {
    "build": "npm run build -w @peoplecore/shared && npm run build -w @peoplecore/api",
    "dev": "npm run build -w @peoplecore/shared && npm run dev -w @peoplecore/api",
    "worker": "npm run build -w @peoplecore/shared && npm run worker -w @peoplecore/api",
    "start": "npm run start -w @peoplecore/api",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "jest --config jest.config.base.js --runInBand",
    "test:e2e": "jest --config apps/api/test/jest-e2e.json --runInBand",
    "test:coverage": "jest --config jest.config.coverage.js --runInBand --coverage",
    "test:load": "k6 run tests/load/employee-list.k6.js",
    "security:secrets": "node scripts/scan-secrets.mjs .",
    "prisma:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema apps/api/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "prisma:seed": "npm run build -w @peoplecore/shared && tsx apps/api/prisma/seeds/index.ts",
    "db:reset": "prisma migrate reset --force --schema apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/supertest": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.1",
    "jest": "^30.5.2",
    "prettier": "^3.7.4",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
